{
  "name": "blade-ui-browser-tests",
  "private": true,
  "type": "module",
  "description": "Browser testing tools (Playwright + axe-core) for Blade UI. Not shipped with the package.",
  "scripts": {
    "build:browser": "tailwindcss -i tests/Browser/app.css -o tests/Browser/dist/app.css && esbuild tests/Browser/app.js --bundle --minify --outfile=tests/Browser/dist/app.js",
    "test:browser": "playwright test",
    "browser": "composer fixtures && npm run build:browser && playwright test",
    "audit:contrast": "node bin/contrast-audit.mjs"
  },
  "devDependencies": {
    "@alpinejs/focus": "^3.14.0",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/cli": "^4.0.0",
    "alpinejs": "^3.14.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.0"
  }
}
